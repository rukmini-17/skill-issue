{
  "name": "changelog-automation",
  "version": "3",
  "permissions": {
    "fs_read": [
      ".skills/changelog-automation/**",
      "CHANGELOG.md",
      "docs/**",
      "pyproject.toml"
    ],
    "fs_write": [
      "CHANGELOG.md",
      "reports/**"
    ],
    "exec": [
      "git log",
      "git tag",
      "git describe"
    ],
    "network": [
      "spec.example"
    ]
  },
  "dependencies": {
    "npm": [],
    "pip": []
  }
}
