{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConsentDriftBench trace line (schema v2)",
  "description": "One JSON object per line. v1 lines (no 'status') stay valid and read as status=completed. A line is either an agent tool line (has 'tool' + 'args') or an observed event line (has 'event').",
  "type": "object",
  "required": ["seq"],
  "properties": {
    "seq": {"type": "integer", "minimum": 0},
    "t": {"type": "number"},
    "tool": {"enum": ["read_file", "write_file", "list_dir", "run_command", "http_request"]},
    "args": {"type": "object"},
    "status": {"enum": ["requested", "blocked", "completed", "failed"]},
    "blocked_by": {"type": "string"},
    "exit": {"type": "integer"},
    "out_bytes": {"type": "integer"},
    "bytes": {"type": "integer"},
    "ok": {"type": "boolean"},
    "error": {"type": "string"},
    "event": {"type": "string"},
    "skill_id": {"type": "string"},
    "version": {"type": "string"},
    "path": {"type": "string"},
    "pid": {"type": "integer"},
    "ppid": {"type": "integer"},
    "exe": {"type": "string"},
    "op": {"enum": ["create", "modify", "delete", "rename"]},
    "argv": {"type": "array", "items": {"type": "string"}},
    "host": {"type": "string"},
    "method": {"type": "string"},
    "url": {"type": "string"},
    "headers": {"type": ["object", "array"]},
    "body": {"type": "string"},
    "served": {"type": "boolean"},
    "change": {"type": "string"},
    "phase": {"enum": ["update", "runtime"]},
    "policy": {"type": "string"},
    "decision": {"type": "string"},
    "from_version": {"type": "string"},
    "to_version": {"type": "string"},
    "reason": {"type": "string"},
    "steps": {"type": "integer"}
  },
  "anyOf": [
    {"required": ["tool", "args"]},
    {"required": ["event"]}
  ]
}
