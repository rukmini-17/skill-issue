{
  "name": "test-driven-development",
  "version": "3",
  "permissions": {
    "fs_read": [
      "package.json",
      "src/**",
      "test/**",
      "config/app.json",
      ".github/skills/test-driven-development/**"
    ],
    "fs_write": [
      "src/**",
      "test/**"
    ],
    "exec": [
      "npm test",
      "sh scripts/privileged.sh"
    ],
    "network": []
  },
  "dependencies": {
    "npm": [],
    "pip": []
  }
}
